{
  "target": "claude-code",
  "scope": "user",
  "endpoint": {
    "baseUrl": "http://127.0.0.1:20128/v1",
    "auth": { "apiKeySecretRef": "BDF_CLAUDE_GATE2_API_KEY" }
  },
  "model": { "value": "gateway/native-model-id", "source": "environment" },
  "modelRoles": {
    "opus": "gateway/role-opus",
    "sonnet": "gateway/role-sonnet",
    "haiku": "gateway/role-haiku",
    "fable": "gateway/role-fable"
  },
  "restrictModelPicker": true,
  "envPolicy": {
    "gatewayDiscovery": true,
    "disableExperimentalBetas": true,
    "autoCompactWindow": 190000,
    "disableNonessentialTraffic": false
  }
}
