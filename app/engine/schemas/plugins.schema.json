{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "title": "Plugins",
    "description": "Validates profiles/<profile>/plugins.json. 'plugin' is an array of plugin id strings.",
    "type": "object",
    "properties": {
        "plugin": {
            "type": "array",
            "items": { "type": "string" }
        }
    },
    "required": [ "plugin" ],
    "additionalProperties": false
}
