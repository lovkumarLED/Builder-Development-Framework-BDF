{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "title": "Profile Settings",
    "description": "Validates profiles/<profile>/settings.json. The builder reads activeProviders from here.",
    "type": "object",
    "properties": {
        "$schema": { "type": "string" },
        "activeProviders": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
        },
        "instructions": {
            "type": "array",
            "items": { "type": "string" }
        }
    },
    "required": [ "activeProviders" ],
    "additionalProperties": false
}
